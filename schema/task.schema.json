{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ex-redteam.invalid/schema/task.schema.json",
  "title": "ex-redteam task spec (task.yaml)",
  "description": "One RL research task for the desk red-team pipeline. Paths are relative to the task directory unless stated otherwise. Every estimate written here is ESTIMATED; every measurement that has not been made is the string UNMEASURED.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "owner", "title", "card", "grader", "reward", "evidence", "known_lawful_recipes", "hidden_data", "contamination", "souping_dependency"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$", "description": "Task id: letters, digits, _ or -; must not start with _ ."},
    "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$", "description": "Task version, e.g. \"1\" or \"v3\". Bump it whenever the card or grader changes."},
    "owner": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": {"name": {"$ref": "#/$defs/text"}, "contact": {"type": "string"}, "team": {"type": "string"}}
    },
    "title": {"$ref": "#/$defs/text"},
    "status": {"enum": ["draft", "ready", "frozen", "retired"]},
    "card": {
      "type": "object", "additionalProperties": false,
      "required": ["file", "goal", "start_state", "allowed_resources", "network_allowlist", "compute_budget", "submission_format"],
      "properties": {
        "file": {"$ref": "#/$defs/relpath", "description": "Full card prose (markdown). Shown to every desk stage."},
        "goal": {"$ref": "#/$defs/text"},
        "start_state": {"$ref": "#/$defs/text"},
        "allowed_resources": {
          "type": "object", "additionalProperties": false, "required": ["tools"],
          "properties": {
            "tools": {"type": "array", "items": {"$ref": "#/$defs/text"}},
            "datasets": {"type": "array", "items": {"$ref": "#/$defs/text"}},
            "models": {"type": "array", "items": {"$ref": "#/$defs/text"}},
            "hardware": {"type": "string"},
            "notes": {"type": "string"}
          }
        },
        "network_allowlist": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "Hosts/URL prefixes the attacker may reach. [] = no network."},
        "compute_budget": {
          "type": "object", "additionalProperties": false, "required": ["gpu_hours"],
          "properties": {
            "gpu_type": {"type": "string"},
            "gpus": {"type": "integer", "minimum": 0},
            "gpu_hours": {"type": "number", "minimum": 0},
            "cpu_cores": {"type": "integer", "minimum": 0},
            "api_usd_cap": {"type": "number", "minimum": 0},
            "notes": {"type": "string"}
          }
        },
        "wallclock_hours": {"type": "number", "exclusiveMinimum": 0, "default": 12},
        "submission_format": {"$ref": "#/$defs/text"}
      }
    },
    "grader": {
      "type": "object", "additionalProperties": false, "required": ["interface_file"],
      "properties": {
        "interface_file": {"$ref": "#/$defs/relpath", "description": "Black-box grader interface (inputs, scoring, query limits). Shown to every desk stage."},
        "source_path": {"type": "string", "minLength": 1, "description": "Grader source/scoring code/config directory or file. Shown READ-ONLY to the white-box probe ONLY. May be outside the task dir."},
        "whitebox_include": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "Extra files under source_path explicitly exposed to the white-box probe even if they match secret_globs."},
        "secret_globs": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "Globs (relative to source_path) always withheld from the white-box copy: secret seeds, keys, hidden labels."},
        "query_limit": {"type": ["integer", "string"]},
        "version": {"type": "string"}
      }
    },
    "reward": {
      "type": "object", "additionalProperties": false, "required": ["definition", "scale", "r1_reference", "r0_baselines", "grader_noise"],
      "properties": {
        "definition": {"$ref": "#/$defs/text"},
        "scale": {
          "type": "object", "additionalProperties": false, "required": ["min", "max", "frozen"],
          "properties": {"min": {"type": "number"}, "max": {"type": "number"}, "frozen": {"const": true, "description": "The reward scale must be frozen before any red-team stage."}, "notes": {"type": "string"}}
        },
        "r1_reference": {
          "type": "object", "additionalProperties": false, "required": ["description"],
          "properties": {"description": {"$ref": "#/$defs/text"}, "source": {"type": "string"}, "anchored_to_sota": {"type": "string"}}
        },
        "r0_baselines": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "score"],
            "properties": {"name": {"$ref": "#/$defs/text"}, "score": {"$ref": "#/$defs/score_or_unmeasured"}, "source": {"type": "string"}}
          }
        },
        "grader_noise": {
          "oneOf": [
            {"const": "UNMEASURED"},
            {"type": "object", "additionalProperties": false, "required": ["sd", "source"],
             "properties": {"sd": {"type": "number", "minimum": 0}, "n": {"type": "integer", "minimum": 2}, "source": {"$ref": "#/$defs/text"}}}
          ]
        },
        "grader_noise_plan": {"type": "string", "description": "Planned measurement when grader_noise is UNMEASURED."}
      }
    },
    "kill_thresholds": {
      "type": "object", "additionalProperties": false,
      "description": "Optional. Defaults come from config/runner.yaml (method/kill_thresholds.md). Any change needs override_reason.",
      "properties": {
        "single_max": {"$ref": "#/$defs/unit"}, "best_of_4": {"$ref": "#/$defs/unit"}, "pass_at_4": {"$ref": "#/$defs/unit"},
        "upper95": {"$ref": "#/$defs/unit"}, "tau": {"$ref": "#/$defs/unit"}, "override_reason": {"type": "string"}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["agent_demonstrated", "subfield_sota"],
      "properties": {
        "sota_file": {"$ref": "#/$defs/relpath"},
        "agent_demonstrated": {"type": "array", "items": {"$ref": "#/$defs/demonstrated"}},
        "subfield_sota": {"type": "array", "items": {"$ref": "#/$defs/sota"}},
        "not_found_reason": {"type": "string", "description": "Required (non-empty) when either list is empty."}
      }
    },
    "known_lawful_recipes": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "source"],
        "properties": {"name": {"$ref": "#/$defs/text"}, "source": {"$ref": "#/$defs/text"}, "year": {"$ref": "#/$defs/year"}, "url": {"$ref": "#/$defs/url"}, "expected_effect": {"type": "string"}}
      }
    },
    "hidden_data": {
      "type": "array",
      "description": "Hidden/held-out data and secret seeds. NEVER copied into any desk workdir; hidden from the desk agent when isolation is bwrap. canary_string is planted in that data for later contamination greps.",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "description"],
        "properties": {"path": {"type": "string", "minLength": 1}, "description": {"$ref": "#/$defs/text"}, "canary_string": {"type": "string", "minLength": 8}}
      }
    },
    "pairings": {
      "type": "object", "additionalProperties": false, "required": ["set", "reason"],
      "description": "Optional override of the canonical pairing set in config/runner.yaml, with a reason.",
      "properties": {
        "set": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pairing"}},
        "reason": {"$ref": "#/$defs/text"}
      }
    },
    "cost_rates": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "usd_per_gpu_hour": {"type": "number", "minimum": 0},
        "api_usd_per_run": {"type": "number", "minimum": 0},
        "gpu_hours_per_run": {"type": "number", "minimum": 0},
        "grade_gpu_hours": {"type": "number", "minimum": 0},
        "basis": {"type": "string", "pattern": "ESTIMATED|UNMEASURED|MEASURED"}
      }
    },
    "desk": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "backend": {"enum": ["codex", "stub"]},
        "model": {"type": "string", "minLength": 1},
        "reasoning_effort": {"enum": ["minimal", "low", "medium", "high", "xhigh"]},
        "web_search": {"type": "boolean"}
      }
    },
    "contamination": {
      "type": "object", "additionalProperties": false, "required": ["notes"],
      "properties": {
        "notes": {"$ref": "#/$defs/text"},
        "public_since": {"type": "string"},
        "known_leaks": {"type": "array", "items": {"type": "string"}},
        "memorization_risk": {"enum": ["low", "medium", "high", "unknown"]}
      }
    },
    "duplicate_check": {
      "type": "object", "additionalProperties": false,
      "properties": {"peer_cards": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "Other tasks' card files (paths relative to this task dir) shown to the desk stages for duplicate checks. Card prose only, never their runs."}}
    },
    "inputs": {
      "type": "object", "additionalProperties": false,
      "properties": {"extra": {"type": "array", "items": {"$ref": "#/$defs/relpath"}, "description": "Extra task files shared with every desk stage (e.g. figures as text, a starter-code listing)."}}
    },
    "souping_dependency": {"const": false, "description": "Souping and model merging are excluded entirely. A task that depends on them is out of scope."},
    "notes": {"type": "string"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "not": {"pattern": "^\\s*(TODO|TBD|FIXME|<[^>]*>)\\s*$"}},
    "relpath": {"type": "string", "minLength": 1, "not": {"pattern": "(^/|^~|(^|/)\\.\\.(/|$))"}, "description": "Relative path inside the task directory."},
    "url": {"type": "string", "pattern": "^https?://"},
    "year": {"type": "integer", "minimum": 1950, "maximum": 2100},
    "unit": {"type": "number", "minimum": 0, "maximum": 1},
    "score_or_unmeasured": {"oneOf": [{"type": "number"}, {"const": "UNMEASURED"}]},
    "source_status": {"enum": ["fetched", "search-only", "unverified"]},
    "demonstrated": {
      "type": "object", "additionalProperties": false,
      "required": ["benchmark", "model", "scaffold", "time", "compute", "achieved", "gap_to_attack", "year", "status"],
      "properties": {
        "benchmark": {"$ref": "#/$defs/text"}, "model": {"$ref": "#/$defs/text"}, "scaffold": {"$ref": "#/$defs/text"},
        "time": {"$ref": "#/$defs/text"}, "compute": {"$ref": "#/$defs/text"}, "achieved": {"$ref": "#/$defs/text"},
        "gap_to_attack": {"$ref": "#/$defs/text"}, "year": {"$ref": "#/$defs/year"}, "url": {"$ref": "#/$defs/url"},
        "status": {"$ref": "#/$defs/source_status"}, "attack_basis": {"enum": ["DEMONSTRATED-AGENT", "LITERATURE-ONLY", "ASSUMED"]}
      }
    },
    "sota": {
      "type": "object", "additionalProperties": false, "required": ["result", "by", "year", "status"],
      "properties": {
        "result": {"$ref": "#/$defs/text"}, "by": {"$ref": "#/$defs/text"}, "year": {"$ref": "#/$defs/year"},
        "url": {"$ref": "#/$defs/url"}, "status": {"$ref": "#/$defs/source_status"}, "north_star_anchor": {"type": "string"}
      }
    },
    "pairing": {
      "type": "object", "additionalProperties": false, "required": ["id", "model", "harness"],
      "properties": {"id": {"type": "string"}, "model": {"type": "string"}, "harness": {"type": "string"}, "pin": {"type": "string"}}
    }
  }
}
